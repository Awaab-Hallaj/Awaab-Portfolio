#!/usr/bin/env node

var app = require('../app');
//explain how the app is connected to Node's HTTP server.
var http = require('http');
//Explain how the server chooses its listening port.
var port = process.env.PORT || 3000;
app.set('port', port);

var server = http.createServer(app);

server.listen(port);
//Explain what the server does when startup encounters an error.
server.on('error', function (error) {
  if (error.code === 'EADDRINUSE') {
    console.error('Port ' + port + ' is already in use');
    process.exit(1);
  }
  throw error;
});
